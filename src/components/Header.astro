---
const currentPath = Astro.url.pathname;

const trainingLinks = [
  {
    name: "All Courses",
    href: "/courses",
    desc: "AIGP, ISO 42001 & Cyber Risk Bootcamps",
    icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>`
  },
  {
    name: "Specialised Training",
    href: "/specialised-training",
    desc: "AI Red-Teaming, FRIA & Watermarking",
    icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`
  },
  {
    name: "Corporate Training",
    href: "/corporate-training",
    desc: "Executive Briefings & Cross-Functional Cohorts",
    icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`
  },
  {
    name: "Certifications",
    href: "/certifications",
    desc: "IAPP AIGP, ISO 42001, ISACA CPE Bridging",
    icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>`
  }
];

const advisoryLinks = [
  {
    name: "Advisory Services",
    href: "/services",
    desc: "AI Governance, ISO 42001, SOC 2, TPRM",
    icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`
  },
  {
    name: "Frameworks & Standards",
    href: "/frameworks",
    desc: "EU AI Act, NIST AI RMF, ISO 27001, ISO 42001",
    icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>`
  },
  {
    name: "Case Studies",
    href: "/case-studies",
    desc: "FinTech, HealthTech & SaaS Transformations",
    icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`
  }
];

const knowledgeLinks = [
  {
    name: "Learning Resources",
    href: "/resources",
    desc: "Toolkits, Gap Checklists, Policies & Lexicon",
    icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"/></svg>`
  },
  {
    name: "Blog & Analysis",
    href: "/blog",
    desc: "EU AI Act, ISO 42001, Watermarking Dispatches",
    icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>`
  },
  {
    name: "About Us",
    href: "/about",
    desc: "Mission, Leadership, Advisory Credentials",
    icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
  },
  {
    name: "Profile & Brochure",
    href: "/company-profile",
    desc: "Corporate Presentation & Verified Media",
    icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>`
  },
  {
    name: "Crawl Page / Sitemap",
    href: "/sitemap",
    desc: "Search Engine Directory & Complete Index",
    icon: `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>`
  }
];

const isTrainingActive = currentPath.startsWith('/courses') || currentPath.startsWith('/specialised-training') || currentPath.startsWith('/corporate-training') || currentPath.startsWith('/certifications');
const isAdvisoryActive = currentPath.startsWith('/services') || currentPath.startsWith('/frameworks') || currentPath.startsWith('/case-studies');
const isKnowledgeActive = currentPath.startsWith('/resources') || currentPath.startsWith('/blog') || currentPath.startsWith('/about') || currentPath.startsWith('/company-profile') || currentPath.startsWith('/sitemap') || currentPath.startsWith('/crawl');
---

<!-- Header with background color #112649 and fonts in white color -->
<header class="sticky top-0 z-50 bg-[#112649] text-white border-b border-[#1d3d75] shadow-md transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Logo & Company Name: RKMIDIGILABS -->
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-lg overflow-hidden bg-white p-0.5 shadow-sm shrink-0 border border-slate-300">
          <img 
            src="/images/rkmidigilabs-logo.jpg" 
            alt="RKMIDIGILABS Logo" 
            class="w-full h-full object-contain"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-white text-base sm:text-lg lg:text-xl tracking-tight leading-none group-hover:text-emerald-400 transition-colors">
            RKMIDIGILABS
          </span>
          <span class="text-[9px] sm:text-[10px] text-slate-300 font-mono tracking-wider uppercase mt-1">
            AI Governance • GRC • Training
          </span>
        </div>
      </a>

      <!-- Desktop Navigation with Categorized Dropdowns Covering all 10 Domains -->
      <nav class="hidden lg:flex items-center gap-1">
        <a 
          href="/" 
          class={`px-3 py-2 rounded-lg text-xs xl:text-sm font-medium transition-colors ${currentPath === '/' ? 'text-white bg-[#1d3d75] font-bold' : 'text-slate-200 hover:text-white hover:bg-[#1a3666]'}`}
        >
          Home
        </a>

        <!-- Dropdown 1: Training & Certifications -->
        <div class="relative group">
          <button 
            type="button"
            class={`px-3 py-2 rounded-lg text-xs xl:text-sm font-medium transition-colors inline-flex items-center gap-1 ${isTrainingActive ? 'text-white bg-[#1d3d75] font-bold' : 'text-slate-200 hover:text-white hover:bg-[#1a3666]'}`}
          >
            <span>Training & Certs</span>
            <svg class="w-4 h-4 text-slate-300 group-hover:text-white transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          
          <div class="absolute left-0 top-full pt-2 w-80 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-1 group-hover:translate-y-0 z-50">
            <div class="bg-[#0b1a33] border border-[#1d3d75] rounded-xl shadow-2xl p-2 space-y-1">
              {trainingLinks.map(link => (
                <a 
                  href={link.href} 
                  class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-[#112649] transition-colors group/item"
                >
                  <div class="p-1.5 rounded-md bg-[#162f59] group-hover/item:bg-emerald-950/60 transition-colors shrink-0" set:html={link.icon}></div>
                  <div>
                    <div class="text-xs font-bold text-white group-hover/item:text-emerald-400 transition-colors">{link.name}</div>
                    <div class="text-[11px] text-slate-300 mt-0.5 leading-snug">{link.desc}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Dropdown 2: Advisory & Solutions -->
        <div class="relative group">
          <button 
            type="button"
            class={`px-3 py-2 rounded-lg text-xs xl:text-sm font-medium transition-colors inline-flex items-center gap-1 ${isAdvisoryActive ? 'text-white bg-[#1d3d75] font-bold' : 'text-slate-200 hover:text-white hover:bg-[#1a3666]'}`}
          >
            <span>Advisory & Practice</span>
            <svg class="w-4 h-4 text-slate-300 group-hover:text-white transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          
          <div class="absolute left-0 top-full pt-2 w-80 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-1 group-hover:translate-y-0 z-50">
            <div class="bg-[#0b1a33] border border-[#1d3d75] rounded-xl shadow-2xl p-2 space-y-1">
              {advisoryLinks.map(link => (
                <a 
                  href={link.href} 
                  class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-[#112649] transition-colors group/item"
                >
                  <div class="p-1.5 rounded-md bg-[#162f59] group-hover/item:bg-emerald-950/60 transition-colors shrink-0" set:html={link.icon}></div>
                  <div>
                    <div class="text-xs font-bold text-white group-hover/item:text-emerald-400 transition-colors">{link.name}</div>
                    <div class="text-[11px] text-slate-300 mt-0.5 leading-snug">{link.desc}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Dropdown 3: Resources & Company -->
        <div class="relative group">
          <button 
            type="button"
            class={`px-3 py-2 rounded-lg text-xs xl:text-sm font-medium transition-colors inline-flex items-center gap-1 ${isKnowledgeActive ? 'text-white bg-[#1d3d75] font-bold' : 'text-slate-200 hover:text-white hover:bg-[#1a3666]'}`}
          >
            <span>Resources & Insights</span>
            <svg class="w-4 h-4 text-slate-300 group-hover:text-white transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          
          <div class="absolute right-0 top-full pt-2 w-80 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-1 group-hover:translate-y-0 z-50">
            <div class="bg-[#0b1a33] border border-[#1d3d75] rounded-xl shadow-2xl p-2 space-y-1">
              {knowledgeLinks.map(link => (
                <a 
                  href={link.href} 
                  class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-[#112649] transition-colors group/item"
                >
                  <div class="p-1.5 rounded-md bg-[#162f59] group-hover/item:bg-emerald-950/60 transition-colors shrink-0" set:html={link.icon}></div>
                  <div>
                    <div class="text-xs font-bold text-white group-hover/item:text-emerald-400 transition-colors">{link.name}</div>
                    <div class="text-[11px] text-slate-300 mt-0.5 leading-snug">{link.desc}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </nav>

      <!-- Action Button & Working CTAs -->
      <div class="hidden sm:flex items-center gap-2">
        <!-- Direct Enquire Mail CTA Button to rkmvedant@gmail.com -->
        <a 
          href="mailto:rkmvedant@gmail.com?subject=Inquiry%20to%20RKMIDIGILABS%3A%20AI%20Governance%20%26%20GRC" 
          class="hidden xl:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-bold bg-[#1d3d75] hover:bg-[#254d93] text-emerald-300 border border-emerald-500/40 transition-all shadow-xs"
          title="Direct Mail Inquiry to rkmvedant@gmail.com"
        >
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span>Enquire Mail</span>
        </a>

        <!-- Student Portal CTA -->
        <a 
          href="/dashboard" 
          class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-mono font-bold bg-[#1d3d75] hover:bg-[#254d93] text-emerald-300 border border-emerald-500/30 transition-all shadow-xs"
          title="Student Learning Portal & Enrolled Courses"
        >
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          <span class="hidden md:inline">Portal</span>
        </a>

        <!-- Green Corporate Primary CTA Button -->
        <a 
          href="/contact" 
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-bold bg-[#16A34A] hover:bg-[#15803D] text-white shadow-sm transition-all"
        >
          <span>Contact Us</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex lg:hidden">
        <button 
          type="button" 
          id="mobile-menu-button"
          class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-[#1a3666]" 
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu with Complete Section Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-[#1d3d75] bg-[#0b1a33] px-4 pt-3 pb-6 space-y-4 shadow-2xl max-h-[80vh] overflow-y-auto">
    <a 
      href="/" 
      class="block px-3 py-2 rounded-lg text-sm font-bold text-white hover:bg-[#162f59]"
    >
      Home
    </a>

    <!-- Category 1: Training & Certifications -->
    <div class="space-y-1">
      <div class="text-[10px] uppercase font-mono tracking-wider text-emerald-400 font-bold px-3">
        Training & Certifications
      </div>
      {trainingLinks.map(link => (
        <a 
          href={link.href} 
          class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-200 hover:text-white hover:bg-[#162f59]"
        >
          <span class="w-4 h-4 text-emerald-400 shrink-0" set:html={link.icon}></span>
          <span>{link.name}</span>
        </a>
      ))}
    </div>

    <!-- Category 2: Advisory & Practice -->
    <div class="space-y-1 pt-2 border-t border-[#1d3d75]/60">
      <div class="text-[10px] uppercase font-mono tracking-wider text-emerald-400 font-bold px-3">
        Advisory & GRC Practice
      </div>
      {advisoryLinks.map(link => (
        <a 
          href={link.href} 
          class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-200 hover:text-white hover:bg-[#162f59]"
        >
          <span class="w-4 h-4 text-emerald-400 shrink-0" set:html={link.icon}></span>
          <span>{link.name}</span>
        </a>
      ))}
    </div>

    <!-- Category 3: Resources & Insights -->
    <div class="space-y-1 pt-2 border-t border-[#1d3d75]/60">
      <div class="text-[10px] uppercase font-mono tracking-wider text-emerald-400 font-bold px-3">
        Resources, Blog & About
      </div>
      {knowledgeLinks.map(link => (
        <a 
          href={link.href} 
          class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-200 hover:text-white hover:bg-[#162f59]"
        >
          <span class="w-4 h-4 text-emerald-400 shrink-0" set:html={link.icon}></span>
          <span>{link.name}</span>
        </a>
      ))}
    </div>

    <!-- Quick Actions in Mobile Menu -->
    <div class="pt-3 border-t border-[#1d3d75] space-y-2">
      <div class="text-xs text-slate-300 font-mono">
        📞 +91 9371650121 • ✉️ rkmvedant@gmail.com
      </div>
      <a 
        href="mailto:rkmvedant@gmail.com?subject=Inquiry%20to%20RKMIDIGILABS%3A%20AI%20Governance%20%26%20GRC" 
        class="w-full text-center flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg font-bold bg-[#1d3d75] hover:bg-[#254d93] text-emerald-300 border border-emerald-500/40 transition-colors shadow-xs text-xs"
      >
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <span>Enquire Mail (rkmvedant@gmail.com)</span>
      </a>
      <a 
        href="/dashboard" 
        class="w-full text-center block py-2.5 px-4 rounded-lg font-bold bg-[#162f59] hover:bg-[#1f427d] text-emerald-300 transition-colors text-xs"
      >
        Student Learning Portal
      </a>
      <a 
        href="/contact" 
        class="w-full text-center block py-2.5 px-4 rounded-lg font-bold bg-[#16A34A] hover:bg-[#15803D] text-white transition-colors text-sm"
      >
        Contact RKMIDIGILABS
      </a>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
