<!-- 1. Full Interactive Secural System Deck (Between Hero & Content) -->
<section id="secural-system-deck" class="relative bg-[#071120] text-white py-14 lg:py-20 border-y border-emerald-950/60 overflow-hidden">
  <!-- Cybernetic Grid & Ambient Glow Background -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_30%,rgba(16,185,129,0.08),transparent_70%)] pointer-events-none"></div>
