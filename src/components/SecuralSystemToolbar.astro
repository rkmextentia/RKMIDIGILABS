<!-- Interactive Client-side Script: 3D Lock Scroll Physics, Quadrillion Counter & Harmonic Wave -->
<script>
  // 1. 3D Lock Perspective & Scroll Tracking
  const lockBody = document.getElementById('lock-3d-body');
  const lockShackle = document.getElementById('lock-shackle');
  const ringOuter = document.getElementById('lock-ring-outer');
  const ringMid = document.getElementById('lock-ring-mid');
  const ringInner = document.getElementById('lock-ring-inner');
  const lockAngleLabel = document.getElementById('lock-angle-label');
  const lockStateLabel = document.getElementById('lock-state-label');
  const floatingToolbar = document.getElementById('floating-secural-toolbar');
  const dockLockIcon = document.getElementById('dock-lock-icon');
  const dockSettleReadout = document.getElementById('dock-settle-readout');
  const dockFragmentText = document.getElementById('dock-fragment-text');
  const dockRecenterBtn = document.getElementById('dock-recenter-btn');

  // GRC Telemetry Fragments Carousel
  const grcFragments = [
    "ISO 42001 & EU AI Act Guardrails Active",
    "Quadrillion Synaptic Vectron Risk Paces Aligned",
    "NIST AI RMF 1.0 (Map • Measure • Manage) Converged",
    "Quantum-Resistant Lattice Shackle: Zero Tamper Found",
    "SOC 2 Type II Automated Continuous Evidence Stream"
  ];
  let fragmentIdx = 0;
  setInterval(() => {
    fragmentIdx = (fragmentIdx + 1) % grcFragments.length;
    if (dockFragmentText) {
      dockFragmentText.textContent = grcFragments[fragmentIdx];
    }
  }, 3500);

  // Recenter button
  if (dockRecenterBtn) {
    dockRecenterBtn.addEventListener('click', () => {
      const deck = document.getElementById('secural-system-deck');
      if (deck) {
        deck.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  // Scroll Event Handler with RequestAnimationFrame for 60fps performance
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        const scrollY = window.scrollY || window.pageYOffset;
        const maxScroll = (document.documentElement.scrollHeight - window.innerHeight) || 1000;
        const progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);

        // 3D Rotation angles based on scroll
        const rotY = (scrollY * 0.22) % 360;
        const rotX = Math.sin(scrollY * 0.003) * 16;
        const rotZ = Math.cos(scrollY * 0.002) * 8;

        if (lockBody) {
          lockBody.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg) rotateZ(${rotZ}deg)`;
        }
        if (ringOuter) {
          ringOuter.style.transform = `rotateZ(${scrollY * 0.15}deg)`;
        }
        if (ringMid) {
          ringMid.style.transform = `rotateZ(${-scrollY * 0.25}deg)`;
        }
        if (ringInner) {
          ringInner.style.transform = `rotateZ(${scrollY * 0.35}deg)`;
        }

        // Shackle tightening as user scrolls down
        if (lockShackle) {
          const shackleTranslate = Math.min(scrollY * 0.02, 6);
          lockShackle.style.transform = `translateY(${shackleTranslate}px)`;
        }

        if (lockAngleLabel) {
          lockAngleLabel.textContent = `ROT: ${rotY.toFixed(1)}°`;
        }

        // Floating Toolbar visibility (shows after scrolling past 380px)
        if (floatingToolbar) {
          if (scrollY > 380) {
            floatingToolbar.classList.remove('translate-y-28', 'opacity-0', 'pointer-events-none');
            floatingToolbar.classList.add('translate-y-0', 'opacity-100');
          } else {
            floatingToolbar.classList.add('translate-y-28', 'opacity-0', 'pointer-events-none');
            floatingToolbar.classList.remove('translate-y-0', 'opacity-100');
          }
        }

        // Dock Lock Icon rotation & progress
        if (dockLockIcon) {
          dockLockIcon.style.transform = `rotate(${rotY * 0.5}deg)`;
        }
        if (dockSettleReadout) {
          const settlePercent = (99.90 + progress * 0.09).toFixed(2);
          dockSettleReadout.textContent = `${settlePercent}% Verified`;
        }

        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  // 1.5 Interactive Mouse & Pen Drag-to-Rotate on 3D Lock Stage
  const stage = document.getElementById('lock-3d-stage');
  if (stage && lockBody) {
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let currentRotY = 0;
    let currentRotX = 0;

    stage.addEventListener('pointerdown', (e) => {
      // Allow mouse left-click, pen tip, or touch
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      try { stage.setPointerCapture(e.pointerId); } catch(err) {}
      stage.classList.add('is-dragging');
      stage.style.cursor = 'grabbing';
      document.body.style.userSelect = 'none';
      if (lockStateLabel) {
        lockStateLabel.textContent = e.pointerType === 'pen' ? 'STYLUS DRAG: ROTATING' : 'MOUSE DRAG: ROTATING';
        lockStateLabel.className = 'text-cyan-400 font-bold';
      }
    });

    stage.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      startX = e.clientX;
      startY = e.clientY;

      currentRotY = (currentRotY + dx * 0.9) % 360;
      currentRotX = Math.max(Math.min(currentRotX - dy * 0.6, 65), -65);

      lockBody.style.transform = `rotateX(${currentRotX}deg) rotateY(${currentRotY}deg) rotateZ(0deg)`;
      if (ringOuter) ringOuter.style.transform = `rotateZ(${currentRotY * 0.5}deg)`;
      if (ringMid) ringMid.style.transform = `rotateZ(${-currentRotY * 0.8}deg)`;
      if (ringInner) ringInner.style.transform = `rotateZ(${currentRotY * 1.2}deg)`;
      if (lockAngleLabel) lockAngleLabel.textContent = `ROT: ${((currentRotY % 360 + 360) % 360).toFixed(1)}°`;
      if (dockLockIcon) dockLockIcon.style.transform = `rotate(${currentRotY * 0.5}deg)`;
    });

    const endDrag = (e) => {
      if (!isDragging) return;
      isDragging = false;
      try { stage.releasePointerCapture(e.pointerId); } catch(err) {}
      stage.classList.remove('is-dragging');
      stage.style.cursor = 'grab';
      document.body.style.userSelect = '';
      if (lockStateLabel) {
        lockStateLabel.textContent = 'SHACKLE ENGAGED';
        lockStateLabel.className = 'text-emerald-300 font-bold';
      }
    };

    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);
  }

  // 2. Real-time Quadrillion Computation Counter Simulation
  const counterEl = document.getElementById('vectron-computation-counter');
  let baseQuadrillion = 2.847194;
  setInterval(() => {
    if (counterEl) {
      // Small simulated quantum variance
      baseQuadrillion += (Math.random() - 0.495) * 0.00012;
      const formatted = baseQuadrillion.toFixed(6).replace('.', ',');
      const parts = formatted.split(',');
      const major = parts[0];
      const minor = parts[1] || '000000';
      counterEl.textContent = `${major}.${minor.slice(0,3)},${minor.slice(3,6)},000,000,000`;
    }
  }, 120);

  // 3. Vectron Harmonic Wave Canvas Animation
  const canvas = document.getElementById('vectron-wave-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let phase = 0;

    const resizeCanvas = () => {
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * (window.devicePixelRatio || 1);
      canvas.height = rect.height * (window.devicePixelRatio || 1);
      if (ctx) ctx.scale(window.devicePixelRatio || 1, window.devicePixelRatio || 1);
    };
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    const renderWave = () => {
      if (!ctx) return;
      const w = canvas.getBoundingClientRect().width;
      const h = canvas.getBoundingClientRect().height;

      ctx.clearRect(0, 0, w, h);

      // Draw cyber harmonic grid
      ctx.strokeStyle = 'rgba(16, 185, 129, 0.08)';
      ctx.lineWidth = 1;
      for (let x = 0; x < w; x += 24) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, h);
        ctx.stroke();
      }

      // Draw primary Vectron wave (representing settled human risk cognition)
      ctx.beginPath();
      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 2;
      ctx.shadowColor = '#10b981';
      ctx.shadowBlur = 8;

      for (let x = 0; x < w; x++) {
        const y = h / 2 + 
          Math.sin(x * 0.02 + phase) * 12 + 
          Math.cos(x * 0.05 - phase * 0.8) * 6;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();

      // Draw secondary cyan resonance wave
      ctx.beginPath();
      ctx.strokeStyle = 'rgba(6, 182, 212, 0.6)';
      ctx.lineWidth = 1.5;
      ctx.shadowColor = '#06b6d4';
      ctx.shadowBlur = 4;

      for (let x = 0; x < w; x++) {
        const y = h / 2 + 
          Math.sin(x * 0.015 - phase * 1.2) * 8 + 
          Math.sin(x * 0.03 + phase * 0.5) * 4;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();

      // Reset shadow for performance
      ctx.shadowBlur = 0;

      phase += 0.035;
      requestAnimationFrame(renderWave);
    };

    renderWave();
  }
</script>
