          <!-- Fragment 3: Cognitive Threat Defense -->
          <div class="p-4 rounded-xl bg-[#0b172a] border border-slate-800 hover:border-emerald-500/40 transition-colors">
            <div class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider mb-1">
              [ADVERSARIAL DEFENSE]
            </div>
            <div class="font-bold text-slate-100 text-sm">Model Extraction Proof</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">
              Real-time heuristic shielding against prompt injection and unauthorized latent exfiltration.
            </p>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<!-- 2. Sticky Floating "Secural System Toolbar" (Bottom-Pinned Cyber Dock on Scroll) -->
<div 
  id="floating-secural-toolbar"
  class="fixed bottom-4 sm:bottom-6 inset-x-0 mx-auto z-40 max-w-4xl px-4 transition-all duration-300 transform translate-y-28 opacity-0 pointer-events-none"
  role="region"
  aria-label="RKMIDIGILABS Secural System Toolbar"
>
  <div class="p-3 sm:p-3.5 rounded-2xl bg-[#081324]/95 border-2 border-emerald-500/40 shadow-[0_15px_40px_rgba(0,0,0,0.8),0_0_25px_rgba(16,185,129,0.25)] backdrop-blur-xl text-white flex items-center justify-between gap-3 pointer-events-auto">
    
    <!-- Left: Mini Rotating 3D Lock & Status Beacon -->
    <div class="flex items-center gap-3">
      <div class="relative w-8 h-8 rounded-lg bg-[#0e213d] border border-emerald-400/60 flex items-center justify-center shrink-0 shadow-inner">
        <svg id="dock-lock-icon" class="w-4 h-4 text-emerald-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <span class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-emerald-400 ring-2 ring-[#081324] animate-pulse"></span>
      </div>

      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs font-bold text-emerald-300 uppercase tracking-tight">SECURAL TOOLBAR</span>
