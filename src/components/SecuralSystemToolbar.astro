            <!-- Heavy Solid Lock Body -->
            <div class="relative -mt-6 w-32 h-24 sm:w-36 sm:h-28 rounded-xl bg-gradient-to-b from-[#193259] via-[#0f213d] to-[#071326] border-2 border-emerald-500/50 shadow-[0_10px_35px_rgba(0,0,0,0.8),inset_0_1px_2px_rgba(255,255,255,0.3)] flex flex-col items-center justify-center p-3">
              <!-- Metallic Rivets -->
              <span class="absolute top-2 left-2 w-1.5 h-1.5 rounded-full bg-slate-400/60 shadow-xs"></span>
              <span class="absolute top-2 right-2 w-1.5 h-1.5 rounded-full bg-slate-400/60 shadow-xs"></span>
