      </div>
    </div>

    <!-- Main Grid: 3D Lock Centerpiece & Vectron Computation Engine -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Column: 3D Interactive Lock & Cryptographic Shackle -->
      <div class="lg:col-span-5 flex flex-col items-center justify-center p-6 sm:p-8 rounded-2xl bg-[#0b172a]/90 border border-slate-700/60 shadow-2xl relative overflow-hidden backdrop-blur-md">
        <div class="absolute -top-16 -left-16 w-44 h-44 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 -right-16 w-44 h-44 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Status Tag -->
        <div class="w-full flex items-center justify-between font-mono text-[11px] text-slate-400 mb-6">
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
