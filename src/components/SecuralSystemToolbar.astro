          <span id="lock-angle-label" class="text-slate-500">ROT: 0.0°</span>
        </div>

        <!-- 3D Lock Viewport (Perspective Container) -->
        <div class="relative w-56 h-56 sm:w-64 sm:h-64 flex items-center justify-center [perspective:1000px] cursor-grab active:cursor-grabbing" id="lock-3d-stage" title="Scroll down or drag to rotate 3D Cryptographic Lock">
          
          <!-- Outer Holographic Compass Ring -->
