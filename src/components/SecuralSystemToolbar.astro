          <!-- Middle Cybernetic Tumbler Ring -->
          <div id="lock-ring-mid" class="absolute w-40 h-40 sm:w-48 sm:h-48 rounded-full border-2 border-cyan-400/30 border-t-emerald-400 border-r-emerald-400 transition-transform duration-150 ease-out"></div>

          <!-- Inner Hash Ring -->
          <div id="lock-ring-inner" class="absolute w-32 h-32 sm:w-36 sm:h-36 rounded-full border border-dashed border-emerald-400/40 transition-transform duration-75 ease-out"></div>

          <!-- The Physical 3D Lock Body & Shackle -->
          <div id="lock-3d-body" class="relative flex flex-col items-center justify-center transition-transform duration-200 ease-out [transform-style:preserve-3d]">
            
            <!-- Shackle Arc (Slides down when scroll increases) -->
            <div id="lock-shackle" class="w-20 h-22 sm:w-24 sm:h-26 rounded-t-full border-[7px] border-slate-300 border-b-0 shadow-[0_0_15px_rgba(255,255,255,0.2)] transition-all duration-300 transform translate-y-1">
