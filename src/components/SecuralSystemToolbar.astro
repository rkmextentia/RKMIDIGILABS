          <!-- Fragment 2: Zero-Trust Shackle -->
          <div class="p-4 rounded-xl bg-[#0b172a] border border-slate-800 hover:border-cyan-500/40 transition-colors">
            <div class="text-[10px] text-cyan-400 font-bold uppercase tracking-wider mb-1">
              [ZERO-TRUST LATTICE]
            </div>
            <div class="font-bold text-slate-100 text-sm">Cryptographic Shackle</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">
              Post-quantum key encapsulation anchoring tamper-proof audit trails for SOC 2 Type II.
            </p>
