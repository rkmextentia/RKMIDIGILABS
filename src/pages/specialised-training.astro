---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Specialised AI & Cybersecurity Training"
  description="Advanced technical masterclasses in AI Red-Teaming, Prompt Injection Defense, Fundamental Rights Impact Assessments (FRIA), and LLM Watermarking."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-[#0b1a33] via-[#112649] to-[#071326] text-white py-16 lg:py-24 border-b border-[#1d3d75] overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_20%,rgba(16,185,129,0.12),transparent_60%)] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 text-xs font-mono font-bold tracking-wider uppercase mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Technical Deep-Dive Tracks
        </div>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight text-white">
          Specialised Training in <span class="text-emerald-400">AI Safety</span>, Red-Teaming & Regulatory Engineering
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
          Go beyond generic compliance theory. Our specialised tracks equip machine learning engineers, security architects, and audit specialists with hands-on methodologies to red-team models, engineer synthetic watermarks, and construct defensible algorithmic safeguards.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a 
            href="#tracks" 
            class="px-6 py-3.5 rounded-xl font-bold text-sm bg-[#16A34A] hover:bg-[#15803D] text-white shadow-md transition-all flex items-center gap-2"
          >
            <span>Explore Technical Tracks</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <a 
            href="mailto:rkmvedant@gmail.com?subject=Specialised%20Training%20Cohort%20Inquiry" 
            class="px-6 py-3.5 rounded-xl font-bold text-sm bg-[#1a3869] hover:bg-[#254d93] text-emerald-300 border border-emerald-500/30 transition-all flex items-center gap-2"
          >
            <span>Request Cohort Syllabus</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Competencies Matrix -->
  <section class="bg-slate-50 border-b border-slate-200 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
          <div class="text-2xl sm:text-3xl font-black text-black font-mono">100%</div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-600 mt-1">Hands-On Lab Scenarios</div>
        </div>
        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
          <div class="text-2xl sm:text-3xl font-black text-emerald-700 font-mono">40+</div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-600 mt-1">Attack & Audit Vectors</div>
        </div>
        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
          <div class="text-2xl sm:text-3xl font-black text-[#112649] font-mono">OWASP</div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-600 mt-1">LLM Top 10 Aligned</div>
        </div>
        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
          <div class="text-2xl sm:text-3xl font-black text-emerald-700 font-mono">CPE / CEU</div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-600 mt-1">Accredited Credits</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Specialised Tracks List -->
  <section id="tracks" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <div class="max-w-2xl mb-12">
      <span class="text-xs font-mono font-bold tracking-widest uppercase text-emerald-700">Course Catalog</span>
      <h2 class="text-3xl sm:text-4xl font-black text-black tracking-tight mt-1">
        Niche Technical Masterclass Tracks
      </h2>
      <p class="text-slate-700 text-sm sm:text-base mt-2">
        Engineered for practitioners who require deep implementation capability in modern AI security, adversarial defense, and high-risk conformity.
      </p>
    </div>

    <div class="space-y-8">
      
      <!-- Track 1: AI Red-Teaming & Prompt Injection -->
      <div class="p-6 sm:p-10 rounded-2xl bg-white border border-slate-300 shadow-md hover:shadow-lg transition-all">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-red-100 text-red-700 font-bold flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            </span>
            <div>
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-red-700">Track 01 • Advanced Adversarial Security</span>
              <h3 class="text-2xl font-black text-black tracking-tight mt-0.5">
                AI Red-Teaming & Adversarial Prompt Injection Defense
              </h3>
            </div>
          </div>
          <span class="px-3 py-1 rounded-full text-xs font-bold font-mono bg-slate-100 text-slate-800 border border-slate-300">
            2 Days • 16 Contact Hours
          </span>
        </div>

        <p class="text-sm text-slate-700 leading-relaxed font-normal mb-6">
          Systematic training on probing, breaking, and fortifying Large Language Model pipelines. Covers Direct & Indirect Prompt Injection, Jailbreak Taxonomy (DAN, Crescendo, Multimodal Encoding), Data Poisoning, Inversion Attacks, and Automated Latent Space Evasion.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-6 border-t border-slate-200">
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Hands-On Labs Covered:</h4>
            <ul class="text-xs text-slate-800 space-y-1.5 font-medium">
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> OWASP Top 10 for LLM Applications Red-Teaming</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Indirect prompt injection via retrieval-augmented (RAG) vector stores</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> NeMo Guardrails, Llama-Guard & System Prompt Armor setup</li>
            </ul>
          </div>
          <div class="flex flex-col justify-between items-start md:items-end">
            <div class="text-xs text-slate-500 font-mono mb-3">Target: SecOps, ML Engineers, Penetration Testers</div>
            <a 
              href="mailto:rkmvedant@gmail.com?subject=Inquiry%3A%20AI%20Red-Teaming%20Specialised%20Track" 
              class="px-5 py-2.5 rounded-lg text-xs font-bold bg-[#112649] hover:bg-[#1a3869] text-white transition-colors"
            >
              Enquire for Cohort Enrollment →
            </a>
          </div>
        </div>
      </div>

      <!-- Track 2: Fundamental Rights Impact Assessment (FRIA) -->
      <div class="p-6 sm:p-10 rounded-2xl bg-white border border-slate-300 shadow-md hover:shadow-lg transition-all">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 font-bold flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </span>
            <div>
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-blue-700">Track 02 • EU AI Act Article 27 Compliance</span>
              <h3 class="text-2xl font-black text-black tracking-tight mt-0.5">
                Fundamental Rights Impact Assessment (FRIA) Practitioner Masterclass
              </h3>
            </div>
          </div>
          <span class="px-3 py-1 rounded-full text-xs font-bold font-mono bg-slate-100 text-slate-800 border border-slate-300">
            1 Day • 8 Contact Hours
          </span>
        </div>

        <p class="text-sm text-slate-700 leading-relaxed font-normal mb-6">
          Step-by-step methodology to conduct mandatory FRIAs under the EU AI Act. Learn how to map algorithmic deployment against EU Charter of Fundamental Rights, engage vulnerable stakeholders, establish human oversight measures, and file formal notifications with National Market Surveillance Authorities.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-6 border-t border-slate-200">
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Hands-On Labs Covered:</h4>
            <ul class="text-xs text-slate-800 space-y-1.5 font-medium">
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> 6-Step European AI Office FRIA Template Execution</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Bias & Disparate Impact Quantification across Protected Attributes</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Post-Market Monitoring & Residual Risk Sign-off Protocols</li>
            </ul>
          </div>
          <div class="flex flex-col justify-between items-start md:items-end">
            <div class="text-xs text-slate-500 font-mono mb-3">Target: DPOs, Compliance Officers, Legal Counsel, Risk Heads</div>
            <a 
              href="mailto:rkmvedant@gmail.com?subject=Inquiry%3A%20FRIA%20Practitioner%20Masterclass" 
              class="px-5 py-2.5 rounded-lg text-xs font-bold bg-[#112649] hover:bg-[#1a3869] text-white transition-colors"
            >
              Enquire for Cohort Enrollment →
            </a>
          </div>
        </div>
      </div>

      <!-- Track 3: Synthetic Media, Watermarking & Article 50 -->
      <div class="p-6 sm:p-10 rounded-2xl bg-white border border-slate-300 shadow-md hover:shadow-lg transition-all">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 font-bold flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </span>
            <div>
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-purple-700">Track 03 • AI Transparency & Provenance</span>
              <h3 class="text-2xl font-black text-black tracking-tight mt-0.5">
                Synthetic Media Watermarking & Provenance Architecture (EU AI Act Art. 50 & C2PA)
              </h3>
            </div>
          </div>
          <span class="px-3 py-1 rounded-full text-xs font-bold font-mono bg-slate-100 text-slate-800 border border-slate-300">
            1 Day • 8 Contact Hours
          </span>
        </div>

        <p class="text-sm text-slate-700 leading-relaxed font-normal mb-6">
          Implement robust machine-readable watermarking, latent-space signatures, and C2PA cryptographic provenance manifests to satisfy the mandatory transparency requirements of the EU AI Act Article 50 for generative audio, video, image, and text content.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-6 border-t border-slate-200">
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Hands-On Labs Covered:</h4>
            <ul class="text-xs text-slate-800 space-y-1.5 font-medium">
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> C2PA Open-Source Content Credentials Manifest Integration</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Statistical Text Watermarking & Entropy Invariant Token Extraction</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Automated Deepfake & Synthetic Content Labeling Pipelines</li>
            </ul>
          </div>
          <div class="flex flex-col justify-between items-start md:items-end">
            <div class="text-xs text-slate-500 font-mono mb-3">Target: Platform Architects, Full-Stack AI Developers, Media Engineers</div>
            <a 
              href="mailto:rkmvedant@gmail.com?subject=Inquiry%3A%20Synthetic%20Watermarking%20Specialised%20Track" 
              class="px-5 py-2.5 rounded-lg text-xs font-bold bg-[#112649] hover:bg-[#1a3869] text-white transition-colors"
            >
              Enquire for Cohort Enrollment →
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA Box -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="p-8 sm:p-12 rounded-2xl bg-[#112649] text-white text-center shadow-xl">
      <h3 class="text-2xl sm:text-3xl font-black tracking-tight">Need a Custom Technical Syllabus for Your Engineering Team?</h3>
      <p class="mt-3 text-sm text-slate-200 max-w-2xl mx-auto">
        We tailor hands-on exercises to your specific tech stack, cloud providers (AWS, Azure, GCP), and proprietary LLM architectures.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
        <a 
          href="mailto:rkmvedant@gmail.com?subject=Custom%20Specialised%20Training%20Syllabus%20Request" 
          class="px-6 py-3.5 rounded-lg font-bold text-sm bg-[#16A34A] hover:bg-[#15803D] text-white shadow-sm transition-colors"
        >
          Enquire via Mail: rkmvedant@gmail.com
        </a>
        <button 
          type="button" 
          data-service="Specialised AI & Cybersecurity Training"
          class="open-inquiry-modal-btn px-6 py-3.5 rounded-lg font-bold text-sm bg-white hover:bg-slate-100 text-slate-900 transition-colors cursor-pointer"
        >
          Quick Inquiry Form →
        </button>
      </div>
    </div>
  </section>
</BaseLayout>
