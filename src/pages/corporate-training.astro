              class="px-4 py-2 rounded-lg text-xs font-bold bg-[#112649] hover:bg-black text-white transition-all"
            >
              Request Lab Overview
            </a>
          </div>
        </div>

        <!-- Track 4: Internal Audit & GRC Practice -->
        <div class="p-8 rounded-2xl border-2 border-slate-200 hover:border-emerald-600 transition-all bg-white shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-purple-50 text-purple-700 border border-purple-200">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                2-Day Intensive Masterclass
              </span>
              <span class="text-xs font-mono text-slate-600 font-bold">Internal Auditors & GRC</span>
            </div>
            <h3 class="text-xl font-black text-black">
              ISO/IEC 42001 Internal Auditor Masterclass
            </h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              A comprehensive program preparing internal audit teams to execute evidence-backed audits of Artificial Intelligence Management Systems (AIMS).
            </p>

            <div class="mt-6 space-y-2.5">
              <div class="text-xs font-bold uppercase tracking-wider text-slate-800">Key Focus Modules:</div>
              <ul class="space-y-2 text-xs sm:text-sm text-slate-600">
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  <span><strong>Clauses 4-10 Deep Dive:</strong> Context, Leadership, Planning, Support, Operation, Evaluation, and Continuous Improvement.</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  <span><strong>Annex A & B Controls:</strong> Auditing model risk assessments, data provenance, and continuous post-market surveillance.</span>
