---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import PostCard from '../components/PostCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SecuralSystemToolbar from '../components/SecuralSystemToolbar.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).filter(p => p.data.published !== false);
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featuredPost = sortedPosts.find(p => p.data.featured) || sortedPosts[0];
const recentPosts = sortedPosts.filter(p => p.id !== featuredPost?.id).slice(0, 3);
---

<BaseLayout 
  title="RKMIDIGILABS — Enterprise AI Governance & GRC Practice"
  description="Executive AI Governance, Enterprise GRC Advisory, and Corporate Training by RKMIDIGILABS. Translating the EU AI Act, NIST AI RMF, and ISO 42001 into audit-ready systems."
>
  <!-- Instant Pre-paint Script: Suppresses deleted or drafted post cards before browser paint -->
  <script is:inline>
    (function() {
      try {
        var deleted = JSON.parse(localStorage.getItem('rkmidigi_deleted_posts') || '[]');
        var toggles = JSON.parse(localStorage.getItem('rkmidigi_post_toggles') || '{}');
        var css = '';
        if (Array.isArray(deleted)) {
          deleted.forEach(function(s) {
            css += '[data-slug="' + s + '"] { display: none !important; }\n';
          });
        }
        Object.keys(toggles).forEach(function(s) {
          if (toggles[s] === false) {
            css += '[data-slug="' + s + '"] { display: none !important; }\n';
          }
        });
        if (css) {
          var el = document.createElement('style');
          el.setAttribute('data-rkmidigi-suppress-home', 'true');
          el.innerHTML = css;
          document.head.appendChild(el);
        }
      } catch(e) {}
    })();
  </script>

  <!-- Hero Section with black fonts, grey highlights, green buttons -->
  <Hero />

  <!-- 3D Lock & Secural System Telemetry Toolbar (Vectron Quadrillion Risk Matrix) -->
  <SecuralSystemToolbar />

  <!-- 10 Dedicated Enterprise Practice & Learning Domains Showcase Section -->
  <section class="py-16 lg:py-24 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-emerald-100 text-emerald-800 border border-emerald-300">
          <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
          Comprehensive Ecosystem
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-black tracking-tight mt-3">
          Explore Our 10 Dedicated Practice & Learning Domains
        </h2>
        <p class="mt-4 text-slate-600 text-sm sm:text-base leading-relaxed">
          From executive certifications and prompt injection red-teaming to regulatory conformity assessments and free audit toolkits—discover everything required to govern and secure enterprise AI.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        
        <!-- 1. Courses -->
        <a 
          href="/courses" 
          class="group p-5 rounded-2xl border-2 border-slate-200 hover:border-emerald-600 transition-all bg-white hover:shadow-lg flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4 group-hover:bg-[#16A34A] group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            </div>
            <h3 class="text-base font-black text-black group-hover:text-emerald-700 transition-colors">Courses & Academy</h3>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">
              Curated masterclasses in ISO 42001, EU AI Act, and NIST AI RMF with video lectures and student dashboard.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1 text-xs font-bold text-emerald-700">
            <span>Explore Courses</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- 2. Specialised Training -->
        <a 
          href="/specialised-training" 
          class="group p-5 rounded-2xl border-2 border-slate-200 hover:border-emerald-600 transition-all bg-white hover:shadow-lg flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4 group-hover:bg-[#112649] group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            </div>
            <h3 class="text-base font-black text-black group-hover:text-emerald-700 transition-colors">Specialised Training</h3>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">
              Technical deep-dives in OWASP LLM Red-Teaming, Prompt Injection Defense, FRIA, and C2PA Watermarking.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1 text-xs font-bold text-emerald-700">
            <span>Technical Tracks</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- 3. Corporate Training -->
        <a 
          href="/corporate-training" 
          class="group p-5 rounded-2xl border-2 border-slate-200 hover:border-emerald-600 transition-all bg-white hover:shadow-lg flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center mb-4 group-hover:bg-purple-700 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </div>
            <h3 class="text-base font-black text-black group-hover:text-emerald-700 transition-colors">Corporate Training</h3>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">
              Executive boardroom briefings, compliance masterclasses, and engineering bootcamps customized to enterprise stacks.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1 text-xs font-bold text-emerald-700">
            <span>Enterprise RFP</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- 4. Advisory Services -->
        <a 
          href="/services" 
          class="group p-5 rounded-2xl border-2 border-slate-200 hover:border-emerald-600 transition-all bg-white hover:shadow-lg flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4 group-hover:bg-[#16A34A] group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <h3 class="text-base font-black text-black group-hover:text-emerald-700 transition-colors">Advisory Services</h3>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">
              EU AI Act High-Risk classification, ISO 42001 certification roadmap, and SOC 2 Type II assurance consulting.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1 text-xs font-bold text-emerald-700">
            <span>View Services</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- 5. Case Studies -->
        <a 
          href="/case-studies" 
          class="group p-5 rounded-2xl border-2 border-slate-200 hover:border-emerald-600 transition-all bg-white hover:shadow-lg flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center mb-4 group-hover:bg-amber-600 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            </div>
            <h3 class="text-base font-black text-black group-hover:text-emerald-700 transition-colors">Case Studies</h3>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">
              Documented transformations across FinTech algorithmic underwriting, HealthTech imaging, and Cloud SaaS.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1 text-xs font-bold text-emerald-700">
            <span>Read Results</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- 6. Frameworks -->
        <a 
          href="/frameworks" 
          class="group p-5 rounded-2xl border-2 border-slate-200 hover:border-emerald-600 transition-all bg-white hover:shadow-lg flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center mb-4 group-hover:bg-teal-700 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
            </div>
            <h3 class="text-base font-black text-black group-hover:text-emerald-700 transition-colors">Regulatory Frameworks</h3>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">
              Clause-by-clause comparative standards for EU AI Act, NIST AI RMF 1.0, ISO 42001, and ISO 27001.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1 text-xs font-bold text-emerald-700">
            <span>Compare Standards</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- 7. Certifications -->
        <a 
          href="/certifications" 
          class="group p-5 rounded-2xl border-2 border-slate-200 hover:border-emerald-600 transition-all bg-white hover:shadow-lg flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-red-50 text-red-600 flex items-center justify-center mb-4 group-hover:bg-red-700 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
            </div>
            <h3 class="text-base font-black text-black group-hover:text-emerald-700 transition-colors">Certifications</h3>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">
              IAPP AIGP, ISO 42001 Lead Implementer & Lead Auditor, and ISACA CISA/CRISC bridging programs.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1 text-xs font-bold text-emerald-700">
            <span>Pass Pathways</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- 8. Learning Resources -->
        <a 
          href="/resources" 
          class="group p-5 rounded-2xl border-2 border-slate-200 hover:border-emerald-600 transition-all bg-white hover:shadow-lg flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4 group-hover:bg-[#16A34A] group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"/></svg>
            </div>
            <h3 class="text-base font-black text-black group-hover:text-emerald-700 transition-colors">Learning Resources</h3>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">
              Downloadable ISO 42001 checklists, FRIA templates, GenAI policies, and comprehensive AI risk glossary.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1 text-xs font-bold text-emerald-700">
            <span>Free Toolkits</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- 9. Blog & Articles -->
        <a 
          href="/blog" 
          class="group p-5 rounded-2xl border-2 border-slate-200 hover:border-emerald-600 transition-all bg-white hover:shadow-lg flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center mb-4 group-hover:bg-rose-700 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
            </div>
            <h3 class="text-base font-black text-black group-hover:text-emerald-700 transition-colors">Blogs & Dispatches</h3>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">
              Daily analyses, technical breakdowns, regulatory change logs, and video dispatches by our lead partners.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1 text-xs font-bold text-emerald-700">
            <span>Read Articles</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- 10. About Us -->
        <a 
          href="/about" 
          class="group p-5 rounded-2xl border-2 border-slate-200 hover:border-emerald-600 transition-all bg-white hover:shadow-lg flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-4 group-hover:bg-[#112649] group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="text-base font-black text-black group-hover:text-emerald-700 transition-colors">About Us</h3>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">
              Meet RKMIDIGILABS leadership, advisory credentials, firm methodology, and cross-border governance reach.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1 text-xs font-bold text-emerald-700">
            <span>Our Mission</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- Featured "Dispatch of the Day" Section -->
  {featuredPost && (
    <section id="home-featured-section" data-slug={featuredPost.slug} class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="p-6 sm:p-10 rounded-2xl bg-white border border-slate-300 shadow-md relative">
        
        <!-- Header -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
          <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded text-xs font-bold uppercase tracking-wider bg-slate-100 text-slate-800 border border-slate-300 mb-2">
              <span class="w-2 h-2 rounded-full bg-[#16A34A]"></span>
              Featured Blog Article
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">
              {featuredPost.data.title}
            </h2>
          </div>
          <a 
            href={`/blog/${featuredPost.slug}`}
            class="inline-flex items-center gap-2 text-sm font-bold text-[#16A34A] hover:text-[#15803D]"
          >
            Read Full Article →
          </a>
        </div>

        <!-- Video Player & Executive Summary Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-7">
            {featuredPost.data.youtubeUrl ? (
              <YouTubeEmbed 
                url={featuredPost.data.youtubeUrl} 
                title={featuredPost.data.title}
              />
            ) : null}
          </div>

          <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
            <div>
              <h3 class="text-xs font-mono uppercase tracking-wider text-slate-500 mb-2 font-bold">Executive Summary:</h3>
              <p class="text-slate-700 text-sm sm:text-base leading-relaxed font-normal">
                {featuredPost.data.summary}
              </p>
            </div>

            <div class="space-y-3 pt-4 border-t border-slate-200">
              <div class="flex items-center gap-2 text-xs font-mono text-slate-600">
                <span class="font-bold text-black">Category:</span>
                <span>{featuredPost.data.category}</span>
                <span>•</span>
                <span>{featuredPost.data.readTime}</span>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {featuredPost.data.tags.map(tag => (
                  <span class="text-xs bg-slate-100 text-slate-700 px-2.5 py-1 rounded border border-slate-300">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Green Action Button -->
            <div class="pt-2">
              <a 
                href={`/blog/${featuredPost.slug}`}
                class="w-full text-center block py-3.5 px-4 rounded-lg font-bold text-sm bg-[#16A34A] hover:bg-[#15803D] text-white transition-colors shadow-sm"
              >
                Read Article & Review Framework Notes
              </a>
            </div>

          </div>

        </div>

      </div>
    </section>
  )}

  <!-- Core Services & Corporate Training Preview -->
  <section class="bg-slate-50 border-y border-slate-200 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-mono font-bold tracking-widest uppercase bg-slate-200 text-slate-800 px-3 py-1 rounded-full">
          RKMIDIGILABS Services
        </span>
        <h2 class="text-3xl font-black text-black tracking-tight mt-3">
          Consulting & Corporate Training
        </h2>
        <p class="mt-3 text-sm text-slate-700 font-normal">
          Bridging high-level regulatory mandates into concrete engineering, data governance, and enterprise risk controls.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <ServiceCard 
          title="AI Governance Consultancy"
          badge="Regulatory Advisory"
          audience="For Product & Legal Teams"
          description="Comprehensive readiness assessments, model classifications, and governance framework design."
          deliverables={[
