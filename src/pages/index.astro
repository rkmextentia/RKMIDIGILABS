  <script>
    import { supabase } from '../lib/supabase';
    import { idbGetAllPosts } from '../lib/idb';

    async function syncHomePosts() {
      const livePostsMap: Record<string, any> = {};

      // 1. Gather custom posts from localStorage
      try {
        const customPosts = JSON.parse(localStorage.getItem('rkmidigi_custom_posts') || '[]');
        if (Array.isArray(customPosts)) {
          customPosts.forEach((p: any) => {
            if (p.slug) livePostsMap[p.slug] = p;
          });
        }
      } catch(e) {}

      // 1.5 Gather custom posts from IndexedDB (unlimited persistent storage)
      try {
        const idbPosts = await idbGetAllPosts();
        if (Array.isArray(idbPosts)) {
          idbPosts.forEach((p: any) => {
            if (p.slug) livePostsMap[p.slug] = { ...(livePostsMap[p.slug] || {}), ...p };
          });
        }
      } catch(e) {}

      // 2. Gather from Supabase database
      try {
        const sbPromise = supabase.from('posts').select('*');
        const timeoutPromise = new Promise(r => setTimeout(r, 2000));
        const res: any = await Promise.race([sbPromise, timeoutPromise]);
        if (res && Array.isArray(res.data)) {
          res.data.forEach((sp: any) => {
            livePostsMap[sp.slug] = {
              slug: sp.slug,
              title: sp.title,
              category: sp.category,
              date: sp.date,
              readTime: sp.read_time,
              featured: sp.featured,
              published: sp.published,
              youtubeUrl: sp.youtube_url,
              image: sp.image,
              summary: sp.summary,
              tags: Array.isArray(sp.tags) ? sp.tags : [],
              body: sp.body,
              author: sp.author || 'RKMIDIGILABS'
            };
          });
        }
      } catch(e) {}

      // 3. Local Node API sync if running locally
      const isLocal = ['localhost', '127.0.0.1'].includes(window.location.hostname);
      if (isLocal) {
        try {
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 1000);
          const res = await fetch(`http://localhost:4322/api/public/posts?_t=${Date.now()}`, { signal: controller.signal });
          clearTimeout(timeoutId);
          if (res.ok) {
            const data = await res.json();
            if (data.success && Array.isArray(data.posts)) {
              data.posts.forEach((p: any) => {
                livePostsMap[p.slug] = p;
              });
            }
          }
        } catch(e) {}
      }

      // 4. Check deleted slugs & toggles
      let deletedSlugs: string[] = [];
      try {
        deletedSlugs = JSON.parse(localStorage.getItem('rkmidigi_deleted_posts') || '[]');
      } catch(e) {}

      let toggles: Record<string, boolean> = {};
      try {
        toggles = JSON.parse(localStorage.getItem('rkmidigi_post_toggles') || '{}');
      } catch(e) {}

      // 5. Featured Section check
      const featuredSection = document.getElementById('home-featured-section');
      if (featuredSection) {
        const featSlug = featuredSection.getAttribute('data-slug');
        if (featSlug) {
          let isPub = true;
          if (typeof toggles[featSlug] === 'boolean') isPub = toggles[featSlug];
          else if (livePostsMap[featSlug]) isPub = livePostsMap[featSlug].published !== false;
          if (deletedSlugs.includes(featSlug)) isPub = false;

          featuredSection.style.display = isPub ? '' : 'none';
        }
      }

      // 6. Recent Cards check
      const recentGrid = document.getElementById('home-recent-grid');
      const recentCards = document.querySelectorAll('.home-recent-wrapper');
      const existingSlugs = new Set<string>();

      recentCards.forEach(card => {
        const slug = card.getAttribute('data-slug');
        if (!slug) return;
        existingSlugs.add(slug);

        if (deletedSlugs.includes(slug)) {
          card.remove();
          return;
        }

        let isPub = true;
        if (typeof toggles[slug] === 'boolean') isPub = toggles[slug];
        else if (livePostsMap[slug]) isPub = livePostsMap[slug].published !== false;

        card.classList.toggle('hidden', !isPub);
        (card as HTMLElement).style.display = isPub ? '' : 'none';
      });

      // 7. Inject newly published custom posts into Recent Grid
      Object.values(livePostsMap).forEach((p: any) => {
        if (!p.slug || existingSlugs.has(p.slug) || deletedSlugs.includes(p.slug)) return;

        let isPub = p.published !== false;
        if (typeof toggles[p.slug] === 'boolean') isPub = toggles[p.slug];
        if (!isPub) return;

        if (recentGrid) {
          existingSlugs.add(p.slug);
          const cardDiv = document.createElement('div');
          cardDiv.className = 'home-recent-wrapper transition-all duration-200';
          cardDiv.setAttribute('data-slug', p.slug);

          const dateStr = p.date ? new Date(p.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
          const tagsHtml = (Array.isArray(p.tags) ? p.tags : []).slice(0, 2).map((t: string) => 
            `<span class="text-[11px] text-slate-600 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">#${t}</span>`
          ).join('');

          cardDiv.innerHTML = `
            <article class="flex flex-col bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-slate-400 shadow-sm hover:shadow-md transition-all duration-200 group">
              <a href="/blog/${p.slug}" class="relative aspect-video overflow-hidden bg-slate-100 block">
                ${p.image ? `<img src="${p.image}" alt="${p.title}" class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300" />` : `
                  <div class="w-full h-full flex items-center justify-center bg-slate-100 text-slate-400">
                    <svg class="w-12 h-12 stroke-current opacity-40" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                  </div>
                `}
                <div class="absolute top-3 left-3">
                  <span class="px-2.5 py-1 rounded text-[11px] font-bold tracking-wide uppercase bg-slate-100 text-slate-800 shadow-sm border border-slate-300">
                    ${p.category || 'AI Governance'}
                  </span>
                </div>
                ${p.youtubeUrl ? `
                  <div class="absolute bottom-3 right-3 flex items-center gap-1.5 px-2 py-0.5 rounded bg-red-600 text-white text-[11px] font-bold shadow-sm">
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    <span>VIDEO</span>
                  </div>
                ` : ''}
              </a>
              <div class="flex-1 p-5 sm:p-6 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2 text-xs text-slate-500 font-mono mb-2">
                    <time>${dateStr}</time>
                    <span>•</span>
                    <span>${p.readTime || '4 min read'}</span>
                  </div>
                  <h3 class="text-base sm:text-lg font-black text-black group-hover:text-[#16A34A] transition-colors leading-snug line-clamp-2">
                    <a href="/blog/${p.slug}">${p.title}</a>
                  </h3>
                  <p class="mt-2 text-sm text-slate-700 line-clamp-2 leading-relaxed font-normal">${p.summary || ''}</p>
                </div>
                <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
                  <div class="flex flex-wrap gap-1.5">${tagsHtml}</div>
                  <a href="/blog/${p.slug}" class="text-xs font-bold text-[#16A34A] hover:text-[#15803D] flex items-center gap-1">
                    Read Article
                    <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
            </article>
          `;
          recentGrid.prepend(cardDiv);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncHomePosts);
    } else {
      syncHomePosts();
    }

    try {
      const bc = new BroadcastChannel('rkmidigi_blog_channel');
      bc.onmessage = () => { syncHomePosts(); };
    } catch(e) {}

    window.addEventListener('storage', (e) => {
      if (e.key === 'rkmidigi_post_toggle' || e.key === 'rkmidigi_post_update' || e.key === 'rkmidigi_custom_posts') {
        syncHomePosts();
      }
    });
    window.addEventListener('focus', syncHomePosts);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') syncHomePosts();
    });
    setInterval(syncHomePosts, 3000);
  </script>

