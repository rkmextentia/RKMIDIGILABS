---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { COURSES } from '../lib/courses-data';

const posts = (await getCollection('blog')).filter(p => p.data.published !== false);
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const mainDomains = [
  { name: "Homepage", href: "/", desc: "Central hub for AI Governance, GRC advisory, and risk telemetry." },
  { name: "About Us", href: "/about", desc: "Leadership, mission, and practice credentials." },
  { name: "All Courses & Academy", href: "/courses", desc: "Flagship masterclasses on ISO 42001, EU AI Act, and NIST AI RMF." },
  { name: "Specialised Training", href: "/specialised-training", desc: "Hands-on tracks in AI Red-Teaming, Prompt Injection Defense, and FRIA." },
  { name: "Corporate Training", href: "/corporate-training", desc: "Executive briefings, workforce upskilling cohorts, and custom enterprise RFPs." },
  { name: "Advisory Services", href: "/services", desc: "Consulting for EU AI Act Annex III conformity, ISO 42001, and SOC 2 Type II." },
  { name: "Blog & Video Dispatches", href: "/blog", desc: "Daily regulatory breakdowns, video tutorials, and technical analyses." },
  { name: "Enterprise Case Studies", href: "/case-studies", desc: "Proven transformations in FinTech, HealthTech, and Cloud SaaS." },
  { name: "Regulatory Frameworks", href: "/frameworks", desc: "Comparative clause analysis for EU AI Act, NIST AI RMF, ISO 42001, and ISO 27001." },
  { name: "Certifications Roadmap", href: "/certifications", desc: "IAPP AIGP, ISO 42001 Lead Implementer/Auditor, and ISACA CPE pathways." },
  { name: "Learning Resources & Toolkits", href: "/resources", desc: "Downloadable checklists, FRIA templates, GenAI policies, and AI lexicon." },
  { name: "Company Profile & Deck", href: "/company-profile", desc: "Executive presentation, verified credentials, and multimedia links." },
  { name: "Contact & Inquiries", href: "/contact", desc: "Direct consultation requests and enterprise RFP submission." },
  { name: "Student Learning Portal", href: "/dashboard", desc: "Enrolled student curriculum tracker and module player." }
];

const frameworkAnchors = [
  { name: "EU AI Act (Annex III High-Risk)", href: "/frameworks#eu-ai-act" },
  { name: "NIST AI RMF 1.0 (Govern, Map, Measure, Manage)", href: "/frameworks#nist-ai-rmf" },
  { name: "ISO/IEC 42001 (AIMS Standard)", href: "/frameworks#iso-42001" },
  { name: "ISO/IEC 27001 & SOC 2 Dual Alignment", href: "/frameworks#iso-27001" }
];

const specialisedTracks = [
  { name: "Track 1: AI Red-Teaming & Prompt Injection Defense", href: "/specialised-training#track-red-teaming" },
  { name: "Track 2: Fundamental Rights Impact Assessment (FRIA)", href: "/specialised-training#track-fria" },
  { name: "Track 3: Synthetic Media Watermarking & Provenance (C2PA)", href: "/specialised-training#track-watermarking" }
];
---

<BaseLayout
  title="Sitemap & Crawl Directory | Search Engine Index"
  description="Complete HTML crawl page and directory of all RKMIDIGILABS AI Governance courses, specialised training tracks, advisory services, case studies, and blog articles."
>
  <div class="bg-slate-50 border-b border-slate-200 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 border border-emerald-300 text-emerald-800 text-xs font-mono font-bold tracking-wider uppercase mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
          Search Engine Crawl Index & Directory
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-black tracking-tight leading-tight">
          Sitemap & <span class="text-emerald-700">Crawl Page</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-700 leading-relaxed font-normal">
          A centralized, crawlable index linking every section, masterclass, framework guide, and technical article across the RKMIDIGILABS platform.
        </p>

        <!-- Backlink to Homepage & Feeds -->
        <div class="mt-6 flex flex-wrap items-center gap-4 text-xs font-bold font-mono">
          <a 
            href="/" 
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-[#112649] text-white hover:bg-black transition-colors shadow-xs"
            title="Backlink to Homepage"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            <span>Back to Homepage (rkmidigilabs.vercel.app)</span>
          </a>
          <a 
            href="/sitemap.xml" 
            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-white border border-slate-300 text-slate-800 hover:bg-slate-100 transition-colors shadow-xs"
            title="Machine-Readable XML Sitemap"
          >
            <span>XML Sitemap (sitemap.xml)</span>
            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
          <a 
            href="/rss.xml" 
            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-white border border-slate-300 text-slate-800 hover:bg-slate-100 transition-colors shadow-xs"
            title="RSS 2.0 Feed"
          >
            <span>RSS Feed (rss.xml)</span>
            <svg class="w-3.5 h-3.5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      
      <!-- Section 1: Core Practice Domains (10 Domains) -->
      <div class="p-6 rounded-2xl bg-white border-2 border-slate-200 shadow-xs lg:col-span-2">
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-slate-200">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
          <h2 class="text-xl font-black text-black">Primary Practice & Learning Domains</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {mainDomains.map(item => (
            <div class="p-3 rounded-xl bg-slate-50 hover:bg-emerald-50/50 border border-slate-200 transition-colors">
              <a 
                href={item.href} 
                class="text-sm font-bold text-black hover:text-emerald-700 transition-colors block"
              >
                {item.name} →
              </a>
              <p class="text-xs text-slate-600 mt-1 leading-snug">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Section 2: Academy Courses & Modules -->
      <div class="p-6 rounded-2xl bg-white border-2 border-slate-200 shadow-xs">
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-slate-200">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
          <h2 class="text-xl font-black text-black">Masterclass Courses</h2>
        </div>
        <ul class="space-y-4">
          {COURSES.map(course => (
            <li class="p-3 rounded-xl bg-slate-50 border border-slate-200">
              <a 
                href={`/courses/${course.slug}`} 
                class="text-sm font-bold text-black hover:text-emerald-700 transition-colors block leading-snug"
              >
                {course.title}
              </a>
              <div class="flex items-center gap-2 text-[11px] font-mono text-slate-500 mt-1.5">
                <span class="text-emerald-700 font-bold">{course.level}</span>
                <span>•</span>
                <span>{course.durationHours}</span>
              </div>
              <div class="mt-2 pt-2 border-t border-slate-200 flex items-center justify-between text-xs">
                <a href={`/courses/${course.slug}`} class="text-[#16A34A] font-bold hover:underline">Syllabus</a>
                <a href={`/courses/${course.slug}/learn`} class="text-slate-600 hover:text-black font-mono">Curriculum Player ↗</a>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Section 3: Specialized Training Tracks -->
      <div class="p-6 rounded-2xl bg-white border-2 border-slate-200 shadow-xs">
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-slate-200">
          <span class="w-2.5 h-2.5 rounded-full bg-purple-600"></span>
          <h2 class="text-lg font-black text-black">Specialised Technical Tracks</h2>
        </div>
        <ul class="space-y-3">
          {specialisedTracks.map(t => (
            <li class="p-3 rounded-xl bg-slate-50 border border-slate-200">
              <a href={t.href} class="text-xs sm:text-sm font-bold text-black hover:text-emerald-700 transition-colors block leading-snug">
                {t.name}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-4 pt-3 border-t border-slate-100">
          <a href="/specialised-training" class="text-xs font-bold text-emerald-700 hover:underline flex items-center gap-1">
            <span>Explore All Specialised Labs</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Section 4: Regulatory Frameworks -->
      <div class="p-6 rounded-2xl bg-white border-2 border-slate-200 shadow-xs">
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-slate-200">
          <span class="w-2.5 h-2.5 rounded-full bg-teal-600"></span>
          <h2 class="text-lg font-black text-black">Regulatory Frameworks</h2>
        </div>
        <ul class="space-y-3">
          {frameworkAnchors.map(f => (
            <li class="p-3 rounded-xl bg-slate-50 border border-slate-200">
              <a href={f.href} class="text-xs sm:text-sm font-bold text-black hover:text-emerald-700 transition-colors block leading-snug">
                {f.name}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-4 pt-3 border-t border-slate-100">
          <a href="/frameworks" class="text-xs font-bold text-emerald-700 hover:underline flex items-center gap-1">
            <span>Compare Global AI Standards</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Section 5: Blog Articles & Video Dispatches -->
      <div class="p-6 rounded-2xl bg-white border-2 border-slate-200 shadow-xs lg:col-span-1">
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-slate-200">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-600"></span>
          <h2 class="text-lg font-black text-black">Technical Blog Dispatches</h2>
        </div>
        <ul class="space-y-3">
          {sortedPosts.map(p => (
            <li class="p-3 rounded-xl bg-slate-50 border border-slate-200">
              <a 
                href={`/blog/${p.slug}`} 
                class="text-xs sm:text-sm font-bold text-black hover:text-emerald-700 transition-colors block leading-snug"
              >
                {p.data.title}
              </a>
              <div class="flex items-center gap-2 text-[10px] font-mono text-slate-500 mt-1">
                <span>{p.data.category}</span>
                <span>•</span>
                <span>{p.data.readTime}</span>
              </div>
            </li>
          ))}
        </ul>
        <div class="mt-4 pt-3 border-t border-slate-100">
          <a href="/blog" class="text-xs font-bold text-emerald-700 hover:underline flex items-center gap-1">
            <span>View Complete Blog Archive</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Crawl Page Reciprocal Backlink Banner -->
    <div class="mt-16 p-8 rounded-2xl bg-[#112649] text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-md border border-[#1d3d75]">
      <div>
        <h3 class="text-xl font-black">Search Engine Crawler Directives</h3>
        <p class="text-xs text-slate-300 mt-1 max-w-xl leading-relaxed">
          All links rendered in this crawl directory are canonical, valid, and fully crawlable by Googlebot, Bingbot, and web spiders. All rights reserved by RKMIDIGILABS.
        </p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <a 
          href="/" 
          class="px-5 py-2.5 rounded-lg text-xs font-bold bg-[#16A34A] hover:bg-[#15803D] text-white shadow-sm transition-all"
        >
          Return to Homepage
        </a>
        <a 
          href="/contact" 
          class="px-5 py-2.5 rounded-lg text-xs font-bold bg-white/10 hover:bg-white/20 text-white border border-white/20 transition-all"
        >
          Contact Us
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
